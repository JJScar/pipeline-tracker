# Pipeline Tracker settings for running it on your own Mac.
# Easiest: leave this file alone and enter your keys in the app under ⚙ Settings.
# Or copy this file to .env and fill in YOUR OWN values:
#   cp .env.example .env
# .env stays on your Mac and is never committed. Leave a line blank to switch that sync off.

# Trellus call sync: your Trellus API key and the email you log into Trellus with.
TRELLUS_API_KEY=
TRELLUS_USER_EMAIL=

# Email sync: a Google app password for your work Gmail (https://myaccount.google.com/apppasswords).
# The address defaults to TRELLUS_USER_EMAIL. Set EMAIL_ADDRESS if your mailbox is different.
GOOGLE_APP_PASSWORD=
# EMAIL_ADDRESS=

# ---- Team mode (the shared server) ----
# Don't set these on your Mac. They're for the company platform; see DEPLOY.md.
# AUTH_MODE=header
# PROXY_SECRET=
# DATA_DIR=/data
# ADMIN_EMAILS=
# ALLOWED_EMAIL_DOMAINS=
